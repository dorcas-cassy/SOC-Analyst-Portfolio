// Microsoft Sentinel scheduled analytic rule
// Case: Alder & Finch — suspected password spray during month-end remote access
let Lookback = 15m;
let BinSize = 5m;
let MinimumAccounts = 5;
SecurityEvent
| where TimeGenerated >= ago(Lookback)
| where EventID == 4625
| where isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1")
// Exclude machine-account failures; tune additional service-account exclusions with ownership approval.
| where TargetUserName !endswith "$"
| summarize FailedAttempts = count(),
    TargetedAccounts = dcount(TargetUserName),
    Accounts = make_set(TargetUserName, 20),
    Hosts = make_set(Computer, 20),
    FailureReasons = make_set(FailureReason, 10)
    by IpAddress, bin(TimeGenerated, BinSize)
| where TargetedAccounts >= MinimumAccounts
| extend AlertTitle = "AFW: multiple accounts failing from one source",
    MITRETechnique = "T1110.003 - Password Spraying",
    SeverityRecommendation = iff(TargetedAccounts >= 10, "High", "Medium")
| project TimeGenerated, AlertTitle, IpAddress, FailedAttempts, TargetedAccounts,
    Accounts, Hosts, FailureReasons, MITRETechnique, SeverityRecommendation
